[gd_scene format=4]

[sub_resource type="Shader" id="Shader_pswnn"]
code = "
	shader_type spatial;

	uniform float ocean_roughness = 0.12;
	uniform float land_roughness = 0.72;

	varying vec3 biome_color;
	varying float terrain_height;

	void vertex() {
		// Pass the vertex colour from SurfaceTool to the fragment shader.
		biome_color = COLOR.rgb;

		// Calculate actual height above the base planet radius.
		terrain_height = length(VERTEX) - 800.000000;
	}

	void fragment() {

		// ==========================================
		// LAND
		// ==========================================

		if (terrain_height >= 0.0) {

			vec3 land_color = biome_color;
			
			land_color *= 0.95;

			// ------------------------------------------
			// Elevation
			// ------------------------------------------

			float elevation = clamp(
				terrain_height / 80.000000,
				0.0,
				1.0
			);

			// Slight variation with elevation.
			land_color *= mix(
				0.90,
				1.05,
				elevation
			);

			// ------------------------------------------
			// Slope / Rock
			// ------------------------------------------

			vec3 radial = normalize(VERTEX);

			float slope = 1.0 - dot(
				NORMAL,
				radial
			);

			float rock_mask = smoothstep(
				0.25,
				0.65,
				slope
			);

			vec3 rock_color = vec3(
				0.30,
				0.29,
				0.27
			);

			land_color = mix(
				land_color,
				rock_color,
				rock_mask * 0.35
			);

			// ------------------------------------------
			// Final land material
			// ------------------------------------------

			ALBEDO = land_color;
			ROUGHNESS = land_roughness;
			SPECULAR = 0.35;
		}

		// ==========================================
		// OCEAN
		// ==========================================

		else {

			float depth = clamp(
				-terrain_height / 24.000000,
				0.0,
				1.0
			);

			vec3 shallow_color = vec3(
				0.06,
				0.30,
				0.40
			);

			vec3 deep_color = vec3(
				0.015,
				0.07,
				0.14
			);

			ALBEDO = mix(
				shallow_color,
				deep_color,
				depth
			);

			ROUGHNESS = ocean_roughness;
			SPECULAR = 0.9;
		}
	}
	"

